# Copy to .env.local (never commit real values).

# Database connection.
#   Local dev without PostgreSQL:  pglite:./.data/dev     (embedded Postgres, stored on disk)
#   Real PostgreSQL:               postgresql://USER:URL_ENCODED_PASSWORD@HOST:5432/DBNAME
#   Supabase: use the session-mode pooler URL (IPv4); the direct db.<ref>.supabase.co host is IPv6-only.
DATABASE_URL=pglite:./.data/dev
# Optional: connection used by `npm run db:migrate` (falls back to DATABASE_URL).
DIRECT_URL=

# TLS for remote PostgreSQL: verify (default) | no-verify (encrypted, server NOT authenticated) | disable (localhost only).
DATABASE_SSL=verify
# CA certificate for providers with their own CA. Supabase's public root CA ships in ./certs.
DATABASE_SSL_CA_PATH=

# One-time code for the first-run admin setup page (/setup); at least 24 random characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SETUP_CODE=

# Public base URL of the app, used to build invitation links.
APP_URL=http://localhost:3000

# PayPal CRM subscriptions. Use sandbox credentials in development and live credentials in production.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CURRENCY=USD
# Webhook ID for the webhook registered at <APP_URL>/api/webhooks/paypal.
PAYPAL_WEBHOOK_ID=

# Optional per-firm QuickBooks Online accounting and client billing. Store credentials server-side.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=
QBO_ENVIRONMENT=sandbox
QBO_TOKEN_ENCRYPTION_KEY=
# Set to 1 only after the firm's sandbox invoice and payment workflow is verified.
QBO_FIRM_FINANCIAL_ACTIONS_ENABLED=
# Protects the scheduled recurring-invoice endpoint; use at least 32 random characters.
CRON_SECRET=

# Email delivery (Resend). Leave blank to disable email; inquiries are still saved as Leads.
RESEND_API_KEY=
EMAIL_FROM=Website <onboarding@resend.dev>
# Where new website-inquiry alerts are sent.
INQUIRY_NOTIFY_EMAIL=

# Dropbox Sign e-signatures (server-side only). Leave blank: the E-Signatures module shows "Setup required".
# Webhook ("account callback") URL: <APP_URL>/api/webhooks/dropbox-sign
DROPBOX_SIGN_API_KEY=
# Optional: an API app client id enables embedded signing sessions.
DROPBOX_SIGN_CLIENT_ID=
# 1 = test requests (not legally binding). Set 0 only for production signing.
DROPBOX_SIGN_TEST_MODE=1
# Set 1 only after a test request completed successfully end to end.
DROPBOX_SIGN_ENABLED=
